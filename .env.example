NODE_ENV=development
WORKSPACE_MODE=local
WEB_HOST=127.0.0.1
WEB_PORT=3000
WEB_ORIGIN=http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://career:career@127.0.0.1:5432/career
APP_ENCRYPTION_KEY=
APP_SESSION_SECRET=
# Optional assistant controls; connecting an account and sharing data require explicit consent in the app.
CAREER_AI_ENABLED=true
AI_ALLOW_PAID_FALLBACK=false
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
AI_BUDGET_TIMEZONE=UTC
AUTOMATION_DEFAULT_LEVEL=2
APPLICATION_WRITES_ENABLED=false
AUTOMATION_SUBMIT_ENABLED=false
AUTOMATION_DAILY_SUBMIT_CAP=0
BROWSER_CONCURRENCY_PER_WORKSPACE=1
EMAIL_INTEGRATION_ENABLED=false
FILES_DRIVER=local
FILES_LOCAL_PATH=./data/files
DIAGNOSTICS_ENABLED=false
LOG_LEVEL=info
