{
  "name": "career-agent-stack",
  "version": "0.9.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/launch.mjs --check",
    "dev": "pnpm run build:shared && pnpm --parallel --filter @career/api --filter @career/dashboard dev",
    "build:shared": "pnpm --filter @career/domain build && pnpm --filter @career/db build",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "db:generate": "pnpm --filter @career/db db:generate",
    "db:migrate": "pnpm --filter @career/db db:migrate",
    "doctor": "node scripts/doctor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "runner": "node scripts/assisted-help.mjs",
    "test:unit": "pnpm --filter @career/api exec tsx --test ../../packages/domain/test/*.test.ts",
    "test:ai": "pnpm --filter @career/api exec tsc --project test/tsconfig.ai.json && pnpm --filter @career/api exec tsx --test ../../packages/domain/test/ai.test.ts ../../packages/domain/test/ai-budget.test.ts ../../packages/domain/test/ai-documents.test.ts test/ai-*.test.ts && node --test scripts/test/ai-capability-probes.test.mjs scripts/test/codex-capability-probe.test.mjs scripts/test/ai-restore.test.mjs",
    "test:integration": "node --test --test-concurrency=1 scripts/test/backup-restore.integration.test.mjs scripts/test/v040-migration.test.mjs scripts/test/v080-migration.test.mjs scripts/test/v090-migration.test.mjs scripts/test/fact-import-migration.test.mjs",
    "test:e2e": "pnpm run build:shared && pnpm --filter @career/api e2e",
    "test:evals": "pnpm --filter @career/api exec tsx --test ../../packages/domain/test/search-matching.test.ts ../../packages/domain/test/search-ranking.test.ts ../../packages/domain/test/search-release-probes.test.ts",
    "reset:session": "node scripts/reset-session.mjs",
    "seed:demo": "pnpm --filter @career/api seed:demo",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test:sources": "pnpm --filter @career/api exec tsx --test test/sources.test.ts",
    "verify:sources": "pnpm --filter @career/api exec tsx scripts/verify-sources.ts",
    "test:backup": "node --test scripts/test/backup-archive.test.mjs",
    "test:backup-api": "pnpm --filter @career/api exec tsx --test test/backup-routes.test.ts",
    "test:setup": "node scripts/test/setup-smoke.mjs",
    "test:bootstrap-db": "node --test scripts/test/bootstrap-database.test.mjs",
    "test:clipboard": "node --test scripts/test/clipboard.test.mjs",
    "test:contributors": "node --test scripts/test/contributors-image.test.mjs",
    "test:process": "node --test scripts/test/process-detection.test.mjs",
    "test:install-marker": "node --test scripts/test/install-marker.test.mjs",
    "test:assisted": "pnpm --filter @career/api exec tsx --test test/assisted-browser.test.ts test/assisted.test.ts",
    "test:discovery": "pnpm --filter @career/api exec tsx --test test/discovery.test.ts",
    "test:searches": "pnpm --filter @career/api exec tsx --test test/job-search*.test.ts test/himalayas-source.test.ts test/search-execution.test.ts test/search-results.test.ts test/job-identity.test.ts",
    "test:fact-import": "pnpm --filter @career/api exec tsx --test test/fact-import.test.ts",
    "test:preparation": "pnpm --filter @career/api exec tsx --test test/preparation*.test.ts",
    "test:edge-cases": "pnpm run build:shared && pnpm --filter @career/api exec tsx e2e/edge-cases.ts",
    "test:search-ui": "pnpm run build:shared && pnpm --filter @career/api exec tsx ../../scripts/run-e2e-v080.mts",
    "test:ai-ui": "pnpm run build:shared && pnpm --filter @career/api exec tsx ../../scripts/run-e2e-v090.mts",
    "test:ui-logic": "pnpm --filter @career/api exec tsx --test ../dashboard/components/application-continuation.test.ts ../dashboard/components/lib/search-status.test.ts ../dashboard/lib/i18n.test.ts ../dashboard/lib/status-pages.test.ts ../dashboard/lib/labels.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
